<mvc:View controllerName="com.ssmc.createordexcptnsom.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:fb="sap.ui.comp.filterbar">
    <Page id="page" title="{i18n>title}" titleAlignment="Center">
        <content>
            <fb:FilterBar persistencyKey="myPersKey" useToolbar="false" search="readTableData"
                filterChange=".onFilterChange" showFilterConfiguration="false" showClearOnFB="true"
                clear="clearFilters" showGoOnFB="true">
                <fb:filterGroupItems>
                    <fb:FilterGroupItem name="oaExceptionRequest" label="OA Exception Request"
                        groupName="A" visibleInFilterBar="true">
                        <fb:control>
                            <Input id="oaExceptionRequest" />
                        </fb:control>
                    </fb:FilterGroupItem>
                    <fb:FilterGroupItem name="vendorCode" label="Vendor Code" groupName="A"
                        visibleInFilterBar="true">
                        <fb:control>
                            <Input id="vendorCode" />
                        </fb:control>
                    </fb:FilterGroupItem>
                    <fb:FilterGroupItem name="approvedDate" label="Approved Date" groupName="A"
                        visibleInFilterBar="true">
                        <fb:control>
                            <DatePicker id="approvedDate" displayFormat="dd MMM yyyy"
                                valueFormat="yyyy-MM-dd" />
                        </fb:control>
                    </fb:FilterGroupItem>
                    <fb:FilterGroupItem name="status" label="Status" groupName="A"
                        visibleInFilterBar="true">
                        <fb:control>
                            <!-- <Input id="status" /> -->
                            <MultiComboBox id="status" items="{statusModel>/}">
                                <core:Item key="{statusModel>Yystatus}"
                                    text="{statusModel>Yystatus}" />
                            </MultiComboBox>
                        </fb:control>
                    </fb:FilterGroupItem>

                    <!-- Column Group 2 (Middle) -->
                    <fb:FilterGroupItem name="requestType" label="Request Type" groupName="A"
                        visibleInFilterBar="true">
                        <fb:control>
                            <Input id="requestType" />
                        </fb:control>
                    </fb:FilterGroupItem>
                    <fb:FilterGroupItem name="poNumber" label="PO number" groupName="A"
                        visibleInFilterBar="true">
                        <fb:control>
                            <Input id="poNumber" />
                        </fb:control>
                    </fb:FilterGroupItem>
                    <fb:FilterGroupItem name="buyer" label="Buyer" groupName="A"
                        visibleInFilterBar="true">
                        <fb:control>
                            <Input id="buyerName" />
                        </fb:control>
                    </fb:FilterGroupItem>
                    <fb:FilterGroupItem name="vendorName" label="Vendor Name" groupName="A"
                        visibleInFilterBar="true">
                        <fb:control>
                            <Input id="vendorName" />
                        </fb:control>
                    </fb:FilterGroupItem>
                    <fb:FilterGroupItem name="dateFrom" label="Date from" groupName="A"
                        visibleInFilterBar="true">
                        <fb:control>
                            <DatePicker id="dateFrom" displayFormat="dd MMM yyyy"
                                valueFormat="yyyy-MM-dd" />
                        </fb:control>
                    </fb:FilterGroupItem>
                    <fb:FilterGroupItem name="dateTo" label="Date to" groupName="A"
                        visibleInFilterBar="true">
                        <fb:control>
                            <DatePicker id="dateTo" displayFormat="dd MMM yyyy"
                                valueFormat="yyyy-MM-dd" />
                        </fb:control>
                    </fb:FilterGroupItem>
                </fb:filterGroupItems>
            </fb:FilterBar>

