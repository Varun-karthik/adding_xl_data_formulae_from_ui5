            <Table id="mainTableId" growing="true" growingThreshold="9999" items="{oaExceptionModel>/}">
                <headerToolbar>
                    <OverflowToolbar>
                        <ToolbarSpacer />
                        <Button text="Create OA Exception" type="Emphasized" press="onCreateExceptionPress" />
                        <Button text="Export" type="Transparent" press="onExportExcel" icon="sap-icon://download" />
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column><Text text="Date" /></Column>
                    <Column><Text text="OA Exception Request" /></Column>
                    <Column><Text text="Request Type" /></Column>
                    <Column><Text text="Vendor Name" /></Column>
                    <Column><Text text="Vendor Code" /></Column>
                    <Column><Text text="PO Number" /></Column>
                    <Column><Text text="Approved Date" /></Column>
                    <Column><Text text="Buyer" /></Column>
                    <Column><Text text="Status" /></Column>
                    <Column><Text text="WholeSale Price" /></Column>
                    <Column><Text text="MRP" /></Column>
                </columns>
                <items>
                    <ColumnListItem type="Navigation" press="onLineItemPress" vAlign="Middle">
                        <cells>
                            <Text text="{path: 'oaExceptionModel>Yycrdate', formatter: '.formatter.formatDate'}" />
                            <Text text="{oaExceptionModel>YyoaExpReqNo}" />
                            <Text text="{oaExceptionModel>YyreqType}" />
                            <Text text="{oaExceptionModel>YysupplierName}" />
                            <Text text="{oaExceptionModel>Yysupplier}" />
                            <Text text="{oaExceptionModel>YypoNum}" />
                            <Text text="{path: 'oaExceptionModel>Yapproveddate', formatter: '.formatter.formatDate'}" />
                            <Text text="{oaExceptionModel>Yycrdby}" />
                            <Text text="{oaExceptionModel>Yystatus}" />
                            <Text text="{oaExceptionModel>YyWSP}" />
                            <Text text="{oaExceptionModel>YyMRP}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>

        </content>
    </Page>
</mvc:View>