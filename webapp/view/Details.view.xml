<mvc:View controllerName="com.ssmc.createordexcptnsom.controller.Details"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    xmlns:fb="sap.ui.comp.filterbar">
    <Page title="Details" titleAlignment="Center">
        <content>
            <f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanL="2"
                labelSpanM="2" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="1"
                emptySpanL="1" emptySpanM="0" columnsXL="1" columnsL="1" columnsM="1">
                <f:content>
                    <Label text="Request Type"></Label>
                    <Select id="rqstTypeDetails" forceSelection="false" width="25%"
                        change="onRqstTypeSelect" editable="false">
                        <items>
                            <core:Item key="Vendor" text="Vendor"></core:Item>
                            <core:Item key="PO" text="PO"></core:Item>
                        </items>
                    </Select>
                </f:content>
            </f:SimpleForm>
            <VBox visible="{viewRqstModel>/vendorType}" class="sapUiTinyMarginTop" width="100%"
                height="100%">
                <f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanL="4"
                    labelSpanM="4" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="1"
                    emptySpanL="1" emptySpanM="0" columnsXL="2" columnsL="2" columnsM="2">
                    <f:content>
                        <core:Title />
                        <Label text="OA Exception Request" />
                        <Input editable="false" value="{LocalDataModel>/YyoaExpReqNo}" />
                        <Label text="Status" />
                        <Input editable="false" value="{LocalDataModel>/Yystatus}" />
                        <core:Title />
                        <Label text="Vendor Code" />
                        <Input editable="false" value="{LocalDataModel>/Yysupplier}" />
                        <Label text="Vendor Name" />
                        <Input editable="false" value="{LocalDataModel>/YysupplierName}" />
                    </f:content>
                </f:SimpleForm>
                <f:SimpleForm visible="true" layout="ResponsiveGridLayout"
                    labelSpanL="12"
                    labelSpanM="12" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0"
                    emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="1"
                    columnsM="2"
                    singleContainerFullSize="true">
                    <f:content>
                        <Label text="Waiver Justification (Vendor Code)" />
                        <TextArea value="{LocalDataModel>/YywavJust}" rows="4" maxLength="2000" editable="false"/>
                        <Label text="Waiver Attachment (Vendor Code)" />
                        <Table
                            items="{path: 'LocalDataModel>/AttachmentSet'}">
                            <columns>
                                <Column>
                                    <Text text="File Name" />
                                </Column>
                                <Column>
                                    <Text text="Download" />
                                </Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Link text="{LocalDataModel>Filename}"
                                            press="onPreviewAttachment" />
                                        <Button icon="sap-icon://download"
                                            press="onDownload" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>

                    </f:content>
                </f:SimpleForm>
            </VBox>
            <VBox visible="{viewRqstModel>/poType}" class="sapUiTinyMarginTop" width="100%"
                height="100%">
                <f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanL="4"
                    labelSpanM="4" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="1"
                    emptySpanL="1" emptySpanM="0" columnsXL="2" columnsL="2" columnsM="2">
                    <f:content>
                        <core:Title />
                        <Label text="OA Exception Request" />
                        <Input editable="false" value="{LocalDataModel>/YyoaExpReqNo}" />
                        <!-- <Label text="Status" />
                    <Input editable="false" value="{LocalDataModel>/YypoCurrency}" /> -->
                        <core:Title />
                        <Label text="PO Number" />
                        <!-- <Input editable="false" value="{LocalDataModel>/Yysupplier}" /> -->
                          <MultiInput id="podtlId" editable="false"/>
                        <Label text="Buyer" />
                        <Input editable="false" value="{LocalDataModel>/Yycrdby}" />
                    </f:content>
                </f:SimpleForm>
                <f:SimpleForm visible="true" layout="ResponsiveGridLayout" labelSpanL="12"
                    labelSpanM="12" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0"
                    emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="1"
                    columnsM="2"
                    singleContainerFullSize="true">
                    <f:content>
                        <Label text="Waiver Justification (PO Number)" />
                        <TextArea value="{LocalDataModel>/YywavJust}" rows="4" maxLength="2000" editable="false"/>
                        <Label text="Waiver Attachment (PO Number)" />
                        <Table items="{path: 'LocalDataModel>/AttachmentSet'}">
                            <columns>
                                <Column>
                                    <Text text="File Name" />
                                </Column>
                                <Column>
                                    <Text text="Download" />
                                </Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Link text="{LocalDataModel>Filename}"
                                            press="onPreviewAttachment" />
                                        <Button icon="sap-icon://download"
                                            press="onDownload" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                        <Label text="PO Details" />
                        <Table growing="true" growingThreshold="50"
                            items="{poDetailsModel>/}">
                            <columns>
                                <Column>
                                    <Text text="Line Item" />
                                </Column>
                                <Column>
                                    <Text text="Supplier Name" />
                                </Column>
                                <Column>
                                    <Text text="PO no." />
                                </Column>
                                <Column>
                                    <Text text="SSMC Part Number" />
                                </Column>
                                <Column>
                                    <Text text="MPN Number" />
                                </Column>
                                <Column>
                                    <Text text="Supplier Part Number" />
                                </Column>
                                <Column>
                                    <Text text="Part Description" />
                                </Column>
                                <Column>
                                    <Text text="Ordered Qty" />
                                </Column>
                                <Column>
                                    <Text text="U/M" />
                                </Column>
                                <Column>
                                    <Text text="Unit Price" />
                                </Column>
                                <Column>
                                    <Text text="Amount" />
                                </Column>
                                <Column>
                                    <Text text="Delivery Date" />
                                </Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{poDetailsModel>YypoLine}" />
                                        <Text text="{poDetailsModel>YysupplierName}" />
                                        <Text text="{poDetailsModel>YypoNum}" />
                                        <Text text="{poDetailsModel>YyssmcPartNo}" />
                                        <Text text="{poDetailsModel>YympnNo}" />
                                        <Text text="{poDetailsModel>YysuppartNo}" />
                                        <Text text="{poDetailsModel>YypartDesc}" />
                                        <Text text="{poDetailsModel>YyorderedQty}" />
                                        <Text text="{poDetailsModel>Yyuom}" />
                                        <Text text="{poDetailsModel>YyunitPrice}" />
                                        <Text text="{poDetailsModel>Yyamount}" />
                                        <Text
                                            text="{path: 'poDetailsModel>YydeliveryDate', formatter: '.formatter.formatDate'}" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </f:content>
                </f:SimpleForm>

            </VBox>
        </content>
        <footer>
            <OverflowToolbar visible="{viewRqstModel>/footerBtns}">
                <ToolbarSpacer />
                <Button text="Cancel Exception" type="Reject" press="onSubmitPress"
                    visible="true" />
                <!-- <Button text="Save" type="Default" press="onSubmitPress"
                    visible="{editableModel>/allowEdit}" />
                <Button text="Submit" type="Accept" press="onSubmitPress"
                    visible="{editableModel>/allowEdit}" /> -->
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View> 